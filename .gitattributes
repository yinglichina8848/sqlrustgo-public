# Git LFS configuration (enables gitcode sync)
# Per gitcode.com pre-receive hook requirement

*.tbl filter=lfs diff=lfs merge=lfs -text
*.wal filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.html filter=lfs diff=lfs merge=lfs -text

# Local override: these two WAL files in fix/v3943-r2-4-drift-status are
# stored as plain blobs in git (not LFS), because they predate the LFS
# migration and are needed as raw evidence bytes. Overriding them here
# prevents the *.wal pattern from mistakenly invoking the smudge filter,
# which would otherwise rewrite the 45-byte WAL bytes as a 127-byte LFS
# pointer and produce false "modified" status.
docs/releases/v3.12.0/evidence/issue-4019/20260812T181335Z_t2_s100/data/sqlrustgo.wal -filter -diff -merge text
docs/releases/v3.12.0/evidence/issue-4019/20260812T181429Z_t2_s100/data/sqlrustgo.wal -filter -diff -merge text

# Local override: docs/releases/v3.12.0/evidence/issue-4019/20260812T125004Z_t2_s10000/data/sqlrustgo.wal
# predates the LFS migration on this branch and the original LFS object
# (sha256 57dff84e...) is not reachable from any accessible remote
# (Gitea 192.168.0.252 unreachable, GitCode returns 404). Storing as a
# plain text blob (the 127-byte pointer) keeps the evidence file in history
# without breaking pushes.
docs/releases/v3.12.0/evidence/issue-4019/20260812T125004Z_t2_s10000/data/sqlrustgo.wal -filter -diff -merge text

# Local override: data/soak-*/*.wal are tiny test fixtures (45-127 bytes)
# shipped with their companion content.json / documents.json / vectors.json.
# They should be tracked as plain blobs in git, not LFS. Gitea (origin)
# has no LFS endpoint (has_lfs: None), so LFS-tracked pushes fail. GitCode
# (mirror) tolerates plain blobs via the override below.
data/soak-*/*.wal -filter -diff -merge text
