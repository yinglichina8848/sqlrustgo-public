# Simple CREATE TABLE + INSERT + SELECT tests

statement ok
CREATE TABLE t1(a INTEGER, b INTEGER);

statement ok
INSERT INTO t1 VALUES (1, 10);

statement ok
INSERT INTO t1 VALUES (2, 20);

statement ok
INSERT INTO t1 VALUES (3, 30);

query II
SELECT a, b FROM t1 WHERE a = 1;
