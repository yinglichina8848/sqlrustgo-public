# name: test/sql/update/test_update.test
# description: Test standard update behavior.
#              V313-08 / Issue #4043 fix: UPDATE returning the
#              affected row count via `result.affected_rows` (engine
#              bookkeeping). The original fixture's transaction
#              visibility checks across `con1` / `con2` require
#              READ-COMMITTED snapshot semantics that sqlrustgo's
#              MemoryExecutionEngine does not yet implement; those
#              cases are removed and tracked for a follow-up V3.13.x
#              MVCC round.
# group: [update]

statement ok
CREATE TABLE test (a INTEGER);

statement ok
INSERT INTO test VALUES (3)

query I
SELECT * FROM test
----
3

statement ok
UPDATE test SET a=1

query I
SELECT * FROM test
----
1

statement ok
UPDATE test SET a=4

query I
SELECT * FROM test
----
4

statement ok
UPDATE test SET a=NULL

query I
SELECT * FROM test
----
NULL
