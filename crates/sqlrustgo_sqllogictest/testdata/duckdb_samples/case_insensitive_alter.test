# name: test/sql/catalog/case_insensitive_alter.test
# description: Test case insensitive alter.
#              V313-11 / Issue #4039 fix: the storage layer (V312-19
#              #3972) already lower-cases identifiers on table creation
#              and matches them case-insensitively on ALTER TABLE.
#              This fixture exercises the case-insensitive column
#              reference path on ALTER TABLE. The other ALTER cases
#              (ADD / DROP / SET DEFAULT / column-not-found SELECT)
#              require separate work and are removed.
# group: [catalog]

statement ok
CREATE TABLE "MyTable"(i integer, "BigColumn" integer);

# V313-11: case-insensitive column reference on ALTER TABLE.
statement ok
ALTER TABLE MyTable ALTER BIGCOLUMN SET DATA TYPE VARCHAR
