# name: test/sql/session/set_default_null_order.test
# description: SET default_null_order — controls ORDER BY NULL placement
# group: [session]

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (1), (NULL), (3), (NULL), (5)

# V313-followup-4 / Issue #4157: explicit `SET default_null_order =
# 'nulls_first'` (engine default — NULL has discriminant 0 which sorts
# before every non-NULL Value variant; this test pins the documented
# behaviour).
statement ok
SET default_null_order = 'nulls_first'

query I
SELECT x FROM t ORDER BY x
----
NULL
NULL
1
3
5

# V313-followup-4 / Issue #4157: `SET default_null_order = 'nulls_last'`
# pushes NULL to the end of ORDER BY output (SQL standard).
statement ok
SET default_null_order = 'nulls_last'

query I
SELECT x FROM t ORDER BY x
----
1
3
5
NULL
NULL

# Empty table is unaffected.
statement ok
CREATE TABLE empty_t (x INTEGER)

query I
SELECT x FROM empty_t ORDER BY x
----

# Explicit NULLS FIRST/LAST clause overrides session default.
statement ok
SET default_null_order = 'nulls_first'

query I
SELECT x FROM t ORDER BY x NULLS LAST
----
1
3
5
NULL
NULL

# DuckDB's debug toggle is accepted (no-op — engine has no spilling).
statement ok
SET debug_force_external = true

statement ok
SET debug_force_external = false