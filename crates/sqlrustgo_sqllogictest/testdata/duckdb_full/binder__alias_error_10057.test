# name: test/sql/binder/alias_error_10057.test
# description: Test that binder rejects unknown column references in CTE.
#              V313-13 / Issue #4041 fix: CTE columns are now resolved
#              from the subquery SELECT list (alias or name), and the
#              binder enforces column existence via
#              engine_utils::validate_select_columns_referenced.
# group: [binder]

statement error .*foobar.*
with test_data as (
  select 'foo' as a
)
select test_data.foobar as new_column from test_data where new_column is not null;
