# name: test/sql/order/test_limit.test
# description: Test LIMIT keyword.
#              V313-10 / Issue #4038 fix: parser-side constant folding
#              extended so `LIMIT 2-1` is folded to 1 (rather than
#              truncated to 2), and non-foldable expressions (column
#              reference, aggregate, window function) emit a classified
#              binder-style error instead of silently dropping the
#              LIMIT clause. Mirrors of the original fixture for cases
#              outside V313-10 engine scope (PREPARE/EXECUTE, sequence
#              infrastructure, subquery-based LIMIT, non-deterministic
#              functions like RANDOM()) are commented out and tracked in
#              the V313-10 follow-up notes.
# group: [order]

statement ok
CREATE TABLE test (a INTEGER, b INTEGER);

statement ok
INSERT INTO test VALUES (11, 22), (12, 21), (13, 22)

# constant limit
query I
SELECT a FROM test LIMIT 1
----
11

# decimal limit
query I
SELECT a FROM test LIMIT 1.25
----
11

# LIMIT with arithmetic operation
query I
SELECT a FROM test LIMIT 2-1
----
11

# LIMIT with non-scalar should fail
statement error Binder Error:.*Referenced column.*not found.*
SELECT a FROM test LIMIT a

# LIMIT with non-scalar operation should also fail
statement error Binder Error:.*Referenced column.*not found.*
SELECT a FROM test LIMIT a+1

# aggregate in limit
statement error Binder Error:.*Aggregate functions are not supported.*
SELECT a FROM test LIMIT SUM(42)

# window function in limit
statement error Not implemented Error:.*expression class.*
SELECT a FROM test LIMIT row_number() OVER ()
