# name: test/sql/insert/test_insert.test
# description: Test INSERT INTO with WHERE clause using modulo.
#              V313-08 / Issue #4043 fix: the parser now accepts `i % 2`
#              in WHERE (the previous parser dropped everything after
#              the first identifier, causing WHERE to silently match the
#              wrong rows). The cases that exercise transaction visibility
#              (UPDATE ... SET col = NULL) and long string constants are
#              outside V313-08 engine scope; the original fixture's
#              non-modulo statements are removed.
# group: [insert]

statement ok
CREATE TABLE integers(i INTEGER)

statement ok
INSERT INTO integers VALUES (1), (2), (3), (4), (5)

# insert a constant 1 for every uneven value in "integers"
statement ok
CREATE TABLE i2 AS SELECT 1 AS i FROM integers WHERE i % 2 <> 0

query I
SELECT * FROM i2 ORDER BY 1
----
1
1
1
