# name: test/sql/setops/test_except.test
# description: Test EXCEPT / INTERSECT.
#              V313-09 / Issue #4042 fix: default EXCEPT is set difference
#              (DISTINCT). V4077 / Issue #4077: NOCASE collation-aware
#              comparison for set operations on text columns.
# group: [setops]

statement ok
CREATE TABLE a(i INTEGER)

statement ok
INSERT INTO a VALUES (41), (42), (43)

statement ok
CREATE TABLE b(i INTEGER)

statement ok
INSERT INTO b VALUES (40), (43), (43)

query I
select * from a except select * from b order by 1
----
41
42

query I
select * from a intersect select * from b
----
43

# V4077 / Issue #4077: NOCASE collation set-ops.
statement ok
CREATE TABLE t1(a VARCHAR COLLATE NOCASE)

statement ok
INSERT INTO t1 VALUES ('ABC'), ('def'), ('GHI')

statement ok
CREATE TABLE t2(a VARCHAR COLLATE NOCASE)

statement ok
INSERT INTO t2 VALUES ('abc'), ('DEF')

# EXCEPT — 'ABC'/'abc' and 'def'/'DEF' match case-insensitively, so
# only 'GHI' remains. Output preserves the LEFT side's original casing.
query I
SELECT * FROM t1 EXCEPT SELECT * FROM t2 ORDER BY a
----
GHI

# INTERSECT — case-insensitive match, output preserves LEFT case ('ABC',
# 'def'). ORDER BY a is binary (sort key 'ABC' < 'def' in ASCII).
query I
SELECT * FROM t1 INTERSECT SELECT * FROM t2 ORDER BY a
----
ABC
def

